<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_equity_trading" model="ir.ui.view">
        <field name="name">res.config.settings.equity.trading</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="after">
                <block title="Equity Trading Governance"
                       name="equity_trading_governance_setting"
                       groups="ics_altahtheeb_equity_trading.group_equity_trading_manager">
                    <setting string="Saudi CJSC minimum shareholders"
                             help="Statutory minimum shareholders for a Saudi closed joint stock company.">
                        <field name="saudi_cjsc_min_shareholders"/>
                    </setting>
                    <setting string="ROFR window (days)"
                             help="Mandatory right-of-first-refusal notice period before external transfers.">
                        <field name="equity_rofr_window_days"/>
                    </setting>
                    <setting string="Maximum ownership concentration (%)"
                             help="Maximum percentage of issued share capital any single shareholder may hold.">
                        <field name="equity_max_ownership_pct"/>
                    </setting>
                    <setting string="Maximum voting power concentration (%)"
                             help="Maximum percentage of aggregate voting rights any single shareholder may control.">
                        <field name="equity_max_voting_power_pct"/>
                    </setting>
                    <setting string="Maximum votes per share"
                             help="Highest permitted votes-per-share weight for any equity class.">
                        <field name="equity_max_votes_per_share"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
