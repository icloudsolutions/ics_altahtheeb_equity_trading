<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="equity_transaction_disposal_view_form" model="ir.ui.view">
        <field name="name">equity.transaction.disposal.form</field>
        <field name="model">equity.transaction.disposal</field>
        <field name="arch" type="xml">
            <form string="FIFO Disposal">
                <group>
                    <field name="sell_transaction_id"/>
                    <field name="holder_id"/>
                    <field name="security_class_id"/>
                    <field name="sell_qty"/>
                    <field name="sell_unit_price"/>
                </group>
                <group string="Result">
                    <field name="cost_basis_total"/>
                    <field name="proceeds_total"/>
                    <field name="realized_gain_loss"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <field name="allocation_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="buy_transaction_id"/>
                        <field name="buy_transaction_date"/>
                        <field name="qty"/>
                        <field name="buy_unit_price"/>
                        <field name="sell_unit_price"/>
                        <field name="cost_basis"/>
                        <field name="proceeds"/>
                        <field name="realized_gain_loss"/>
                    </list>
                </field>
                <footer>
                    <button name="action_process_disposal"
                            string="Process FIFO Disposal"
                            type="object"
                            class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="equity_lot_allocation_view_list" model="ir.ui.view">
        <field name="name">equity.lot.allocation.list</field>
        <field name="model">equity.lot.allocation</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="sell_transaction_id"/>
                <field name="buy_transaction_id"/>
                <field name="buy_transaction_date"/>
                <field name="qty"/>
                <field name="buy_unit_price"/>
                <field name="sell_unit_price"/>
                <field name="cost_basis"/>
                <field name="proceeds"/>
                <field name="realized_gain_loss"/>
            </list>
        </field>
    </record>

</odoo>
