<?xml version="1.0" encoding="utf-8"?>
<!--
    ics_altahtheeb_equity_trading_portal_templates.xml
    ===================================================
    Portal QWeb templates for the Al Tahtheeb Equity Trading module.

    Design principles
    -----------------
    * No inline CSS — all presentation is expressed through native Odoo 19
      Bootstrap 5 utility classes available in the portal layout.
    * Bilingual-aware: labels are translatable via ``_()``; Arabic text support
      is inherited from the portal's ``lang`` context.
    * Accessibility: semantic ``<th scope>``, ARIA roles, and ``aria-label``
      attributes are used throughout.
    * Mobile-first: Bootstrap 5 column helpers (``col-12 col-sm-6 col-xl-4``)
      ensure a consistent experience on all screen sizes.

    Templates defined
    -----------------
    1. ``portal_trading_templates``          — parent grouping record.
    2. ``portal_my_home_portfolio``          — injects "My Portfolio" entry on
                                              the My Account home page.
    3. ``portal_sign_iframe_view``           — Odoo Sign iframe for pending
                                              equity transfer signatures.
    4. ``portal_portfolio_dashboard_view``   — My Portfolio Dashboard (this PR).
    5. ``marketplace_dashboard_view``        — Active listing marketplace.
-->
<odoo>

    <!-- ================================================================== -->
    <!-- 1. Parent grouping template                                         -->
    <!-- ================================================================== -->
    <template id="portal_trading_templates"
              name="Al Tahtheeb Equity Trading Portal Templates">
        <!-- Grouping record; individual templates are referenced by ID. -->
    </template>


    <!-- ================================================================== -->
    <!-- 2. My Account home page — Portfolio entry card                      -->
    <!-- ================================================================== -->
    <template id="portal_my_home_portfolio"
              name="Portal My Home: Portfolio Dashboard"
              inherit_id="portal.portal_my_home"
              customize_show="True"
              priority="35">
        <!--
            Enable the "Services" category section so our entry appears in its
            own group rather than being appended to the generic documents list.
        -->
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>

        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon">/equity/static/src/img/equity.svg</t>
                <t t-set="title">My Portfolio</t>
                <t t-set="url" t-value="'/my/equity/portfolio'"/>
                <t t-set="text">Review your shareholdings and completed trade history</t>
                <t t-set="placeholder_count" t-value="'portfolio_count'"/>
            </t>
        </div>
    </template>


    <!-- ================================================================== -->
    <!-- 3. Odoo Sign iframe — pending equity transfer signature             -->
    <!-- ================================================================== -->
    <template id="portal_sign_iframe_view"
              name="Al Tahtheeb Equity — Sign Iframe">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Sign Equity Transaction</t>

            <div class="o_portal_wrap">
                <div class="container py-4">

                    <!-- Breadcrumb -->
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/my/home" class="text-decoration-none">My Account</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/my/equity" class="text-decoration-none">Equity Dashboard</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Sign Document
                            </li>
                        </ol>
                    </nav>

                    <!-- Sign card -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-bottom py-3 px-4">
                            <div class="d-flex align-items-center gap-3">
                                <!-- pen icon from Bootstrap Icons (bundled with Odoo 19) -->
                                <span class="text-primary fs-4" aria-hidden="true">✍</span>
                                <div>
                                    <h1 class="h5 fw-semibold mb-1">Share Transfer Agreement</h1>
                                    <p class="text-muted small mb-0">
                                        <t t-esc="sign_request.reference"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <iframe t-att-src="sign_url"
                                    width="100%"
                                    height="750"
                                    title="Electronic Signature — Share Transfer Agreement"
                                    class="d-block w-100 border-0"
                                    allow="clipboard-read; clipboard-write"/>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>


    <!-- ================================================================== -->
    <!-- 4. My Portfolio Dashboard                                           -->
    <!-- ================================================================== -->
    <!--
        Context variables provided by the Python controller:
        ┌─────────────────────────┬───────────────────────────────────────────┐
        │ current_partner         │ res.partner of the authenticated user     │
        │ total_shares            │ int / float — aggregated share count      │
        │ portfolio_valuation     │ float — sum of cap-table valuation fields │
        │ display_currency        │ res.currency browse record                │
        │ has_mixed_currencies    │ bool — multi-currency portfolio flag      │
        │ share_class_rows        │ list[dict] — per-class allocation rows    │
        │ has_holdings            │ bool — True when share_class_rows is set  │
        │ transaction_rows        │ list[dict] — completed transaction rows   │
        │ has_transactions        │ bool — True when transaction_rows is set  │
        │ fmt_amount              │ callable(amount, currency) → str          │
        │ fmt_date                │ callable(date_val) → str                  │
        │ today                   │ date — server-side today for comparisons  │
        └─────────────────────────┴───────────────────────────────────────────┘

        Each transaction_row dict contains:
          date, reference, share_class, operation_code ('buy'|'sell'|'other'),
          operation_label, qty, unit_price, currency, state, state_label
    -->
    <template id="portal_portfolio_dashboard_view"
              name="My Portfolio Dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">My Portfolio Dashboard</t>

            <div class="o_portal_wrap bg-light">
                <div class="container-fluid container-lg py-4 px-3 px-md-4">

                    <!-- -------------------------------------------------- -->
                    <!-- Breadcrumb                                            -->
                    <!-- -------------------------------------------------- -->
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/my/home" class="text-decoration-none">My Account</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/my/equity" class="text-decoration-none">Equity Dashboard</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                My Portfolio
                            </li>
                        </ol>
                    </nav>

                    <!-- -------------------------------------------------- -->
                    <!-- Page header card                                      -->
                    <!-- -------------------------------------------------- -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4 p-md-5">
                            <div class="d-flex flex-column flex-md-row
                                        justify-content-between align-items-md-center gap-3">
                                <div>
                                    <h1 class="h2 fw-semibold mb-2">My Portfolio Dashboard</h1>
                                    <p class="text-muted mb-0">
                                        Live share allocations and completed equity ledger activity
                                        for <strong t-esc="current_partner.display_name"/>.
                                    </p>
                                </div>
                                <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                                    <a href="/my/equity/marketplace"
                                       class="btn btn-outline-primary">
                                        Marketplace
                                    </a>
                                    <a href="/my/equity"
                                       class="btn btn-outline-secondary">
                                        Equity Dashboard
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- -------------------------------------------------- -->
                    <!-- Summary cards row                                     -->
                    <!-- -------------------------------------------------- -->
                    <div class="row g-4 mb-4">

                        <!-- Summary Box 1: Total Shares Owned -->
                        <div class="col-12 col-sm-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between
                                                align-items-start mb-3">
                                        <p class="text-uppercase text-muted
                                                  fw-semibold small mb-0 lh-1">
                                            Total Shares Owned
                                        </p>
                                        <!--
                                            Bootstrap 5 badge used as a
                                            decorative icon-label; no custom
                                            CSS needed.
                                        -->
                                        <span class="badge rounded-pill text-bg-primary
                                                     fw-normal small"
                                              aria-hidden="true">
                                            Cap Table
                                        </span>
                                    </div>

                                    <t t-if="has_holdings">
                                        <p class="display-6 fw-bold text-primary mb-1">
                                            <t t-esc="total_shares"/>
                                        </p>
                                        <p class="text-muted small mb-0">
                                            Aggregated active share allocations
                                            across all equity classes.
                                        </p>
                                    </t>
                                    <t t-else="">
                                        <p class="display-6 fw-bold text-secondary mb-1">0</p>
                                        <p class="text-muted small mb-0">
                                            No active share allocations are recorded yet.
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Summary Box 2: Current Portfolio Valuation -->
                        <div class="col-12 col-sm-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between
                                                align-items-start mb-3">
                                        <p class="text-uppercase text-muted
                                                  fw-semibold small mb-0 lh-1">
                                            Current Portfolio Valuation
                                        </p>
                                        <span class="badge rounded-pill text-bg-success
                                                     fw-normal small"
                                              aria-hidden="true">
                                            Live
                                        </span>
                                    </div>

                                    <t t-if="has_holdings">
                                        <p class="display-6 fw-bold text-success mb-1">
                                            <t t-esc="fmt_amount(portfolio_valuation, display_currency)"/>
                                        </p>
                                        <p class="text-muted small mb-0">
                                            <t t-if="has_mixed_currencies">
                                                Estimated value across companies.
                                                Amounts are expressed in mixed currencies.
                                            </t>
                                            <t t-else="">
                                                Based on the latest company valuation
                                                and your current ownership share.
                                            </t>
                                        </p>
                                    </t>
                                    <t t-else="">
                                        <p class="display-6 fw-bold text-secondary mb-1">—</p>
                                        <p class="text-muted small mb-0">
                                            No valuation data available yet.
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </div>

                    </div>
                    <!-- /Summary cards row -->

                    <!-- -------------------------------------------------- -->
                    <!-- Current Share Allocations table                       -->
                    <!-- -------------------------------------------------- -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white border-bottom py-3 px-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <h2 class="h5 fw-semibold mb-0">Current Share Allocations</h2>
                                <t t-if="has_holdings">
                                    <span class="badge rounded-pill text-bg-light
                                                 border text-secondary fw-normal">
                                        <t t-esc="len(share_class_rows)"/> class(es)
                                    </span>
                                </t>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <t t-if="not has_holdings">
                                <!-- Empty state -->
                                <div class="p-4 p-md-5 text-center">
                                    <p class="text-muted mb-1 fs-5">No active holdings</p>
                                    <p class="text-muted small mb-0">
                                        Your equity allocations will appear here once shares
                                        are recorded in the cap table.
                                    </p>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col" class="ps-4 py-3 fw-semibold">
                                                    Company
                                                </th>
                                                <th scope="col" class="py-3 fw-semibold">
                                                    Share Class
                                                </th>
                                                <th scope="col"
                                                    class="py-3 fw-semibold text-end">
                                                    Shares Held
                                                </th>
                                                <th scope="col"
                                                    class="pe-4 py-3 fw-semibold text-end">
                                                    Estimated Value
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="share_class_rows"
                                               t-as="allocation">
                                                <tr>
                                                    <td class="ps-4 py-3">
                                                        <t t-esc="allocation['company_name']"/>
                                                    </td>
                                                    <td class="py-3">
                                                        <span class="fw-semibold">
                                                            <t t-esc="allocation['class_name']"/>
                                                        </span>
                                                    </td>
                                                    <td class="py-3 text-end fw-semibold">
                                                        <t t-esc="allocation['shares']"/>
                                                    </td>
                                                    <td class="pe-4 py-3 text-end text-success fw-semibold">
                                                        <t t-esc="fmt_amount(allocation['valuation'], allocation['currency'])"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <!-- Totals footer row -->
                                        <tfoot class="table-light border-top">
                                            <tr>
                                                <td class="ps-4 py-3 fw-semibold"
                                                    colspan="2">
                                                    Total
                                                </td>
                                                <td class="py-3 text-end fw-bold text-primary">
                                                    <t t-esc="total_shares"/>
                                                </td>
                                                <td class="pe-4 py-3 text-end fw-bold text-success">
                                                    <t t-esc="fmt_amount(portfolio_valuation, display_currency)"/>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </t>
                        </div>
                    </div>
                    <!-- /Current Share Allocations -->

                    <!-- -------------------------------------------------- -->
                    <!-- Historical Transactions Log                           -->
                    <!-- -------------------------------------------------- -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-bottom py-3 px-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <h2 class="h5 fw-semibold mb-0">Historical Transactions Log</h2>
                                <t t-if="has_transactions">
                                    <span class="badge rounded-pill text-bg-light
                                                 border text-secondary fw-normal">
                                        <t t-esc="len(transaction_rows)"/> record(s)
                                    </span>
                                </t>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <t t-if="not has_transactions">
                                <!-- Empty state -->
                                <div class="p-4 p-md-5 text-center">
                                    <p class="text-muted mb-1 fs-5">No completed transactions yet</p>
                                    <p class="text-muted small mb-0">
                                        Completed equity transfers and issuances will appear
                                        here once their ledger state is finalised.
                                    </p>
                                    <a href="/my/equity/marketplace"
                                       class="btn btn-outline-primary btn-sm mt-3">
                                        Browse Marketplace
                                    </a>
                                </div>
                            </t>
                            <t t-else="">
                                <!--
                                    Responsive wrapper: on small screens the table
                                    scrolls horizontally rather than wrapping awkwardly.
                                -->
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0"
                                           aria-label="Historical Equity Transactions">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col"
                                                    class="ps-4 py-3 fw-semibold text-nowrap">
                                                    Date
                                                </th>
                                                <th scope="col"
                                                    class="py-3 fw-semibold">
                                                    Transaction Reference
                                                </th>
                                                <th scope="col"
                                                    class="py-3 fw-semibold">
                                                    Share Class
                                                </th>
                                                <th scope="col"
                                                    class="py-3 fw-semibold">
                                                    Operation Type
                                                </th>
                                                <th scope="col"
                                                    class="py-3 fw-semibold text-end">
                                                    Share Qty
                                                </th>
                                                <th scope="col"
                                                    class="py-3 fw-semibold text-end">
                                                    Unit Price
                                                </th>
                                                <th scope="col"
                                                    class="pe-4 py-3 fw-semibold text-end">
                                                    Ledger State
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="transaction_rows" t-as="row">
                                                <tr>
                                                    <!-- Date -->
                                                    <td class="ps-4 py-3 text-nowrap text-muted small">
                                                        <t t-if="row['date']">
                                                            <t t-esc="fmt_date(row['date'])"/>
                                                        </t>
                                                        <t t-else="">—</t>
                                                    </td>

                                                    <!-- Transaction Reference -->
                                                    <td class="py-3 fw-semibold">
                                                        <t t-esc="row['reference']"/>
                                                    </td>

                                                    <!-- Share Class -->
                                                    <td class="py-3 text-muted">
                                                        <t t-esc="row['share_class']"/>
                                                    </td>

                                                    <!-- Operation Type badge -->
                                                    <!--
                                                        Bootstrap 5 contextual badges:
                                                        buy   → text-bg-success (green)
                                                        sell  → text-bg-danger  (red)
                                                        other → text-bg-secondary (grey)
                                                        No custom CSS required.
                                                    -->
                                                    <td class="py-3">
                                                        <t t-if="row['operation_code'] == 'buy'">
                                                            <span class="badge rounded-pill text-bg-success fw-semibold">
                                                                ↑ <t t-esc="row['operation_label']"/>
                                                            </span>
                                                        </t>
                                                        <t t-elif="row['operation_code'] == 'sell'">
                                                            <span class="badge rounded-pill text-bg-danger fw-semibold">
                                                                ↓ <t t-esc="row['operation_label']"/>
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge rounded-pill text-bg-secondary fw-semibold">
                                                                <t t-esc="row['operation_label']"/>
                                                            </span>
                                                        </t>
                                                    </td>

                                                    <!-- Share Qty -->
                                                    <td class="py-3 text-end fw-semibold">
                                                        <t t-esc="row['qty']"/>
                                                    </td>

                                                    <!-- Unit Price -->
                                                    <td class="py-3 text-end text-muted">
                                                        <t t-esc="fmt_amount(row['unit_price'], row['currency'])"/>
                                                    </td>

                                                    <!-- Ledger State — always green success badge -->
                                                    <td class="pe-4 py-3 text-end">
                                                        <span class="badge rounded-pill text-bg-success"
                                                              t-att-title="row['state']">
                                                            ✓ <t t-esc="row['state_label']"/>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>

                        <!-- Card footer: last refreshed timestamp -->
                        <div class="card-footer bg-white border-top py-2 px-4">
                            <p class="text-muted small mb-0">
                                Data reflects the equity cap table as of
                                <strong t-esc="fmt_date(today)"/>.
                                Contact your equity administrator for discrepancies.
                            </p>
                        </div>
                    </div>
                    <!-- /Historical Transactions Log -->

                </div>
            </div>
        </t>
    </template>


    <!-- ================================================================== -->
    <!-- 5. Active Listing Marketplace                                       -->
    <!-- ================================================================== -->
    <template id="marketplace_dashboard_view"
              name="Al Tahtheeb Marketplace Dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Al Tahtheeb Internal Share Marketplace</t>

            <div class="o_portal_wrap bg-light">
                <div class="container-fluid container-lg py-4 px-3 px-md-4">

                    <!-- Breadcrumb -->
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/my/home" class="text-decoration-none">My Account</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/my/equity" class="text-decoration-none">Equity Dashboard</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Marketplace
                            </li>
                        </ol>
                    </nav>

                    <!-- Page header card -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4 p-md-5">
                            <div class="d-flex flex-column flex-md-row
                                        justify-content-between align-items-md-center gap-3">
                                <div>
                                    <h1 class="h2 fw-semibold mb-2">
                                        Al Tahtheeb Internal Share Marketplace
                                    </h1>
                                    <p class="text-muted mb-0">
                                        Review active share listings, ROFR notice periods,
                                        and submit buy proposals.
                                    </p>
                                </div>
                                <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                                    <a href="/my/equity/portfolio"
                                       class="btn btn-outline-primary">
                                        My Portfolio
                                    </a>
                                    <a href="/my/equity"
                                       class="btn btn-outline-secondary">
                                        Back to Dashboard
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Flash messages -->
                    <t t-if="success_message">
                        <div class="alert alert-success alert-dismissible fade show mb-4"
                             role="alert">
                            <t t-esc="success_message"/>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close"/>
                        </div>
                    </t>
                    <t t-if="error_message">
                        <div class="alert alert-danger alert-dismissible fade show mb-4"
                             role="alert">
                            <t t-esc="error_message"/>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close"/>
                        </div>
                    </t>

                    <!-- Active Listings card -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-bottom py-3 px-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <h2 class="h5 fw-semibold mb-0">Active Listings</h2>
                                <t t-if="listings">
                                    <span class="badge rounded-pill text-bg-light
                                                 border text-secondary fw-normal">
                                        <t t-esc="len(listings)"/> listing(s)
                                    </span>
                                </t>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <t t-if="not listings">
                                <div class="p-4 p-md-5 text-center">
                                    <p class="text-muted mb-1 fs-5">No active listings</p>
                                    <p class="text-muted small mb-0">
                                        No published share listings are currently available.
                                        Check back later or contact your equity administrator.
                                    </p>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0"
                                           aria-label="Active Share Marketplace Listings">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col"
                                                    class="ps-4 py-3 fw-semibold">Listing ID</th>
                                                <th scope="col"
                                                    class="py-3 fw-semibold">Share Class</th>
                                                <th scope="col"
                                                    class="py-3 fw-semibold text-end">Total Shares</th>
                                                <th scope="col"
                                                    class="py-3 fw-semibold text-end">Price / Share</th>
                                                <th scope="col"
                                                    class="py-3 fw-semibold text-end">Total Value</th>
                                                <th scope="col"
                                                    class="pe-4 py-3 fw-semibold text-end">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="listings" t-as="listing">
                                                <tr>
                                                    <td class="ps-4 py-3">
                                                        <div class="fw-semibold">
                                                            <t t-esc="listing.name"/>
                                                        </div>
                                                        <t t-if="listing.rofr_deadline
                                                                  and listing.rofr_deadline >= today">
                                                            <span class="badge rounded-pill
                                                                         text-bg-warning mt-1">
                                                                ROFR Notice Period Active
                                                            </span>
                                                        </t>
                                                    </td>
                                                    <td class="py-3 text-muted">
                                                        <t t-esc="listing.share_class_id.display_name"/>
                                                    </td>
                                                    <td class="py-3 text-end fw-semibold">
                                                        <t t-esc="listing.qty"/>
                                                    </td>
                                                    <td class="py-3 text-end text-muted">
                                                        <t t-esc="format_listing_amount(listing.price_unit, listing.currency_id)"/>
                                                    </td>
                                                    <td class="py-3 text-end fw-semibold text-success">
                                                        <t t-esc="format_listing_amount(listing.price_total, listing.currency_id)"/>
                                                    </td>
                                                    <td class="pe-4 py-3 text-end">
                                                        <t t-if="listing.shareholder_id == current_partner">
                                                            <span class="badge rounded-pill
                                                                         text-bg-light border
                                                                         text-muted fw-normal">
                                                                Your listing
                                                            </span>
                                                        </t>
                                                        <t t-elif="listing.listing_type == 'sell'">
                                                            <t t-if="listing.rofr_deadline
                                                                      and listing.rofr_deadline > today">
                                                                <span class="text-muted small">
                                                                    Available after ROFR deadline
                                                                </span>
                                                            </t>
                                                            <t t-else="">
                                                                <button type="button"
                                                                        class="btn btn-success btn-sm"
                                                                        data-bs-toggle="modal"
                                                                        t-attf-data-bs-target="#marketplaceModal{{ listing.id }}">
                                                                    Submit Buy Proposal
                                                                </button>
                                                            </t>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-muted small">—</span>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>
                    </div>
                    <!-- /Active Listings card -->

                    <!-- -------------------------------------------------- -->
                    <!-- Confirmation modals (one per actionable listing)     -->
                    <!-- -------------------------------------------------- -->
                    <t t-foreach="listings" t-as="listing">
                        <t t-if="listing.listing_type == 'sell'
                                 and listing.shareholder_id != current_partner
                                 and (not listing.rofr_deadline
                                      or listing.rofr_deadline &lt;= today)">
                            <div class="modal fade"
                                 t-attf-id="marketplaceModal{{ listing.id }}"
                                 tabindex="-1"
                                 t-attf-aria-labelledby="marketplaceModalLabel{{ listing.id }}"
                                 aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">

                                        <div class="modal-header border-0 pb-0 px-4 pt-4">
                                            <h3 class="modal-title h5 fw-semibold"
                                                t-attf-id="marketplaceModalLabel{{ listing.id }}">
                                                Confirm Buy Proposal
                                            </h3>
                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal"
                                                    aria-label="Close"/>
                                        </div>

                                        <div class="modal-body px-4 py-3">
                                            <p class="text-muted mb-3">
                                                Are you sure you want to commit to purchasing
                                                these equity shares? This action triggers the
                                                statutory legal approval process.
                                            </p>
                                            <dl class="row mb-0 small">
                                                <dt class="col-5 text-muted">Listing ID</dt>
                                                <dd class="col-7 fw-semibold mb-2">
                                                    <t t-esc="listing.name"/>
                                                </dd>
                                                <dt class="col-5 text-muted">Share Class</dt>
                                                <dd class="col-7 mb-2">
                                                    <t t-esc="listing.share_class_id.display_name"/>
                                                </dd>
                                                <dt class="col-5 text-muted">Total Shares</dt>
                                                <dd class="col-7 fw-semibold mb-2">
                                                    <t t-esc="listing.qty"/>
                                                </dd>
                                                <dt class="col-5 text-muted">Total Value</dt>
                                                <dd class="col-7 fw-bold text-success mb-0">
                                                    <t t-esc="format_listing_amount(listing.price_total, listing.currency_id)"/>
                                                </dd>
                                            </dl>
                                        </div>

                                        <div class="modal-footer border-0 px-4 pb-4 pt-2 gap-2">
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    data-bs-dismiss="modal">
                                                Cancel
                                            </button>
                                            <form t-attf-action="/my/equity/marketplace/match/{{ listing.id }}"
                                                  method="post"
                                                  class="d-inline m-0">
                                                <input type="hidden"
                                                       name="csrf_token"
                                                       t-att-value="request.csrf_token()"/>
                                                <button type="submit"
                                                        class="btn btn-success">
                                                    Confirm — Submit Buy Proposal
                                                </button>
                                            </form>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                    <!-- /Confirmation modals -->

                </div>
            </div>
        </t>
    </template>

</odoo>
