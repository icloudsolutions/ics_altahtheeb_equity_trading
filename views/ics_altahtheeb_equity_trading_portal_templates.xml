<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_sign_iframe_view" name="Al Tahtheeb Equity Sign Iframe">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Sign Equity Transaction</t>

            <div class="o_portal_wrap">
                <div class="container pt-3 pb-5">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item">
                                <a href="/my/home">My Account</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/my/equity">Equity Dashboard</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a t-attf-href="/my/equity/#{transaction.partner_id.id}">
                                    <t t-esc="transaction.partner_id.display_name"/>
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Sign Document
                            </li>
                        </ol>
                    </nav>

                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white py-3">
                            <h4 class="mb-1">Share Transfer Agreement</h4>
                            <p class="text-muted mb-0 small">
                                <t t-esc="sign_request.reference"/>
                            </p>
                        </div>
                        <div class="card-body p-0">
                            <iframe t-att-src="sign_url"
                                    width="100%"
                                    height="750px"
                                    border="0"
                                    title="Electronic Signature"
                                    class="d-block w-100"
                                    allow="clipboard-read; clipboard-write"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="marketplace_dashboard_view" name="Al Tahtheeb Marketplace Dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Al Tahtheeb Internal Share Marketplace</t>

            <div class="o_portal_wrap">
                <div class="container-fluid container-lg py-4 px-3 px-md-4">
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/my/home" class="text-decoration-none">My Account</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/my/equity" class="text-decoration-none">Equity Dashboard</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Marketplace
                            </li>
                        </ol>
                    </nav>

                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-body p-4 p-md-5">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                <div>
                                    <h1 class="h2 mb-2 fw-semibold">
                                        Al Tahtheeb Internal Share Marketplace
                                    </h1>
                                    <p class="text-muted mb-0">
                                        Review active share listings, ROFR notice periods, and submit buy proposals.
                                    </p>
                                </div>
                                <a href="/my/equity" class="btn btn-outline-secondary align-self-start align-self-md-center">
                                    Back to Dashboard
                                </a>
                            </div>
                        </div>
                    </div>

                    <t t-if="success_message">
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <t t-esc="success_message"/>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
                        </div>
                    </t>
                    <t t-if="error_message">
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <t t-esc="error_message"/>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
                        </div>
                    </t>

                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white py-3 px-4">
                            <h2 class="h5 mb-0 fw-semibold">Active Listings</h2>
                        </div>
                        <div class="card-body p-0">
                            <t t-if="not listings">
                                <div class="p-4 p-md-5">
                                    <div class="alert alert-info mb-0" role="status">
                                        No published listings are currently available.
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col" class="ps-4 py-3">Listing ID</th>
                                                <th scope="col" class="py-3">Share Class</th>
                                                <th scope="col" class="py-3 text-end">Total Shares</th>
                                                <th scope="col" class="py-3 text-end">Price Per Share</th>
                                                <th scope="col" class="py-3 text-end">Total Value</th>
                                                <th scope="col" class="pe-4 py-3 text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="listings" t-as="listing">
                                                <tr>
                                                    <td class="ps-4 py-3">
                                                        <div class="fw-semibold" t-esc="listing.name"/>
                                                        <t t-if="listing.rofr_deadline and listing.rofr_deadline &gt;= today">
                                                            <span class="badge rounded-pill text-bg-warning mt-2">
                                                                ROFR Premium Notice Period
                                                            </span>
                                                        </t>
                                                    </td>
                                                    <td class="py-3" t-esc="listing.share_class_id.display_name"/>
                                                    <td class="py-3 text-end" t-esc="listing.qty"/>
                                                    <td class="py-3 text-end">
                                                        <t t-esc="format_listing_amount(listing.price_unit, listing.currency_id)"/>
                                                    </td>
                                                    <td class="py-3 text-end fw-semibold">
                                                        <t t-esc="format_listing_amount(listing.price_total, listing.currency_id)"/>
                                                    </td>
                                                    <td class="pe-4 py-3 text-end">
                                                        <t t-if="listing.shareholder_id == current_partner">
                                                            <span class="text-muted small">Your listing</span>
                                                        </t>
                                                        <t t-elif="listing.listing_type == 'sell'">
                                                            <t t-if="listing.rofr_deadline and listing.rofr_deadline &gt; today">
                                                                <span class="text-muted small">
                                                                    Available after ROFR
                                                                </span>
                                                            </t>
                                                            <t t-else="">
                                                                <button type="button"
                                                                        class="btn btn-success btn-sm"
                                                                        data-bs-toggle="modal"
                                                                        t-attf-data-bs-target="#marketplaceConfirmModal#{listing.id}">
                                                                    Submit Buy Proposal
                                                                </button>
                                                            </t>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-muted small">—</span>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>
                    </div>

                    <t t-foreach="listings" t-as="listing">
                        <t t-if="listing.listing_type == 'sell'
                                 and listing.shareholder_id != current_partner
                                 and (not listing.rofr_deadline or listing.rofr_deadline &lt;= today)">
                            <div class="modal fade"
                                 t-attf-id="marketplaceConfirmModal#{listing.id}"
                                 tabindex="-1"
                                 t-attf-aria-labelledby="marketplaceConfirmModalLabel#{listing.id}"
                                 aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <div class="modal-header border-0 pb-0 px-4 pt-4">
                                            <h3 class="modal-title h5 fw-semibold"
                                                t-attf-id="marketplaceConfirmModalLabel#{listing.id}">
                                                Confirm Buy Proposal
                                            </h3>
                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal"
                                                    aria-label="Close"/>
                                        </div>
                                        <div class="modal-body px-4 py-3">
                                            <p class="mb-3">
                                                Are you sure you want to commit to purchasing these equity shares?
                                                This action triggers statutory legal approval processes.
                                            </p>
                                            <dl class="row mb-0 small text-muted">
                                                <dt class="col-sm-4">Listing</dt>
                                                <dd class="col-sm-8 mb-2" t-esc="listing.name"/>
                                                <dt class="col-sm-4">Share Class</dt>
                                                <dd class="col-sm-8 mb-2" t-esc="listing.share_class_id.display_name"/>
                                                <dt class="col-sm-4">Total Shares</dt>
                                                <dd class="col-sm-8 mb-2" t-esc="listing.qty"/>
                                                <dt class="col-sm-4">Total Value</dt>
                                                <dd class="col-sm-8 mb-0">
                                                    <t t-esc="format_listing_amount(listing.price_total, listing.currency_id)"/>
                                                </dd>
                                            </dl>
                                        </div>
                                        <div class="modal-footer border-0 px-4 pb-4 pt-0 gap-2">
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    data-bs-dismiss="modal">
                                                Cancel
                                            </button>
                                            <form t-attf-action="/my/equity/marketplace/match/#{listing.id}"
                                                  method="post"
                                                  class="d-inline">
                                                <input type="hidden"
                                                       name="csrf_token"
                                                       t-att-value="request.csrf_token()"/>
                                                <button type="submit" class="btn btn-success">
                                                    Submit Buy Proposal
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </t>
    </template>

</odoo>
