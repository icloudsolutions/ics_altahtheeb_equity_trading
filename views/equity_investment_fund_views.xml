<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="equity_investment_fund_view_list" model="ir.ui.view">
        <field name="name">equity.investment.fund.list</field>
        <field name="model">equity.investment.fund</field>
        <field name="arch" type="xml">
            <list string="Investment Funds">
                <field name="code"/>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="analytic_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="equity_investment_fund_view_form" model="ir.ui.view">
        <field name="name">equity.investment.fund.form</field>
        <field name="model">equity.investment.fund</field>
        <field name="arch" type="xml">
            <form string="Investment Fund">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Fund name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Fund">
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="analytic_account_id"/>
                            <field name="journal_id"/>
                            <field name="holder_ids" widget="many2many_tags"/>
                        </group>
                        <group string="General Ledger Accounts">
                            <field name="book_value_account_id"/>
                            <field name="revaluation_account_id"/>
                            <field name="unrealized_gain_loss_account_id"/>
                            <field name="financial_tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Portfolio Assets">
                            <field name="portfolio_asset_ids">
                                <list editable="bottom">
                                    <field name="share_class_id"/>
                                    <field name="market_price"/>
                                    <field name="current_quantity"/>
                                    <field name="current_market_value"/>
                                    <field name="current_book_value"/>
                                    <field name="book_value_account_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="equity_investment_fund_action" model="ir.actions.act_window">
        <field name="name">Investment Funds</field>
        <field name="res_model">equity.investment.fund</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
