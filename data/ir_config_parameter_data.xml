<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="config_stale_signature_days" model="ir.config_parameter">
        <field name="key">ics_altahtheeb_equity_trading.stale_signature_days</field>
        <field name="value">5</field>
    </record>

    <record id="config_market_feed_batch_size" model="ir.config_parameter">
        <field name="key">ics_altahtheeb_equity_trading.market_feed_batch_size</field>
        <field name="value">50</field>
