<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ics_altahtheeb_equity_trading.EquityTradingDashboard">
    <div class="o_equity_trading_dashboard" style="padding-bottom: 2rem;">

        <!-- ── Loading state ─────────────────────────────────────────────── -->
        <t t-if="ui.loading">
            <div class="d-flex align-items-center justify-content-center" style="min-height:400px;">
                <div class="text-center text-muted">
                    <div class="spinner-border text-primary mb-3" role="status" style="width:3rem;height:3rem;">
                        <span class="visually-hidden">Loading…</span>
                    </div>
                    <p class="fw-semibold">Loading dashboard…</p>
                </div>
            </div>
        </t>

        <!-- ── Main content ──────────────────────────────────────────────── -->
        <t t-else="">

            <!-- ══ Header bar ══════════════════════════════════════════════ -->
            <div class="o_etd_header d-flex align-items-center justify-content-between px-4 py-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-line-chart text-primary fs-4"/>
                    <div>
                        <h4 class="mb-0 fw-bold">Equity Trading Dashboard</h4>
                        <small class="text-muted">
                            <t t-esc="companyDisplayName"/>
                            · Internal Share Marketplace
                        </small>
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <!-- Filter toggle -->
                    <button class="btn btn-sm o_etd_filter_toggle"
                            t-att-class="ui.filtersOpen ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="toggleFiltersPanel">
                        <i class="fa fa-filter me-1"/>
                        Filters
                        <t t-if="showFilterBadge">
                            <span class="badge bg-danger ms-1" t-esc="activeFilterCount"/>
                        </t>
                    </button>
                    <!-- Clear filters -->
                    <t t-if="hasActiveFilters">
                        <button class="btn btn-sm btn-link text-danger text-decoration-none p-0"
                                t-on-click="clearFilters">
                            <i class="fa fa-times-circle me-1"/>Clear
                        </button>
                    </t>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="refresh"
                            t-att-disabled="ui.refreshing">
                        <i t-att-class="ui.refreshing ? 'fa fa-spinner fa-spin me-1' : 'fa fa-refresh me-1'"/>
                        Refresh
                    </button>
                    <button class="btn btn-sm btn-primary" t-on-click="openMarketplace">
                        <i class="fa fa-list me-1"/>Marketplace
                    </button>
                </div>
            </div>

            <!-- ══ Filter panel (collapsible) ══════════════════════════════ -->
            <t t-if="ui.filtersOpen">
                <div class="o_etd_filter_panel px-4 py-3 border-bottom">
                    <div class="row g-3 align-items-end">

                        <!-- Company -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label class="o_etd_filter_label">
                                <i class="fa fa-building me-1"/>Company
                            </label>
                            <select class="form-select form-select-sm"
                                    t-on-change="onCompanyFilterChange">
                                <option value="">All Companies</option>
                                <t t-foreach="filterOptions.companies" t-as="co" t-key="co.id">
                                    <option t-att-value="co.id"
                                            t-att-selected="filters.company_id === co.id"
                                            t-esc="co.name"/>
                                </t>
                            </select>
                        </div>

                        <!-- Listing Type -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label class="o_etd_filter_label">
                                <i class="fa fa-exchange me-1"/>Listing Type
                            </label>
                            <div class="d-flex gap-1 flex-wrap">
                                <t t-foreach="filterOptions.listing_types" t-as="typeOption" t-key="typeOption.value">
                                    <button
                                        t-att-class="listingTypeButtonClass(typeOption.value)"
                                        t-att-data-value="typeOption.value"
                                        t-on-click="onListingTypeFilterClick">
                                        <t t-esc="typeOption.label"/>
                                    </button>
                                </t>
                            </div>
                        </div>

                        <!-- State -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label class="o_etd_filter_label">
                                <i class="fa fa-tasks me-1"/>Status
                            </label>
                            <select class="form-select form-select-sm"
                                    t-on-change="onStateFilterChange">
                                <t t-foreach="filterOptions.states" t-as="st" t-key="st.value">
                                    <option t-att-value="st.value"
                                            t-att-selected="filters.state_filter === st.value"
                                            t-esc="st.label"/>
                                </t>
                            </select>
                        </div>

                        <!-- Period -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label class="o_etd_filter_label">
                                <i class="fa fa-calendar me-1"/>Period
                            </label>
                            <select class="form-select form-select-sm"
                                    t-on-change="onPeriodFilterChange">
                                <t t-foreach="filterOptions.periods" t-as="pd" t-key="pd.value">
                                    <option t-att-value="pd.value"
                                            t-att-selected="filters.period === pd.value"
                                            t-esc="pd.label"/>
                                </t>
                            </select>
                        </div>

                    </div>

                    <!-- Active filter chips -->
                    <t t-if="hasActiveFilters">
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <t t-if="filters.company_id">
                                <span class="o_etd_chip">
                                    <i class="fa fa-building me-1"/>
                                    <t t-esc="selectedCompanyName"/>
                                    <button class="o_etd_chip_remove" t-on-click="clearCompanyFilter">×</button>
                                </span>
                            </t>
                            <t t-if="filters.listing_type !== 'all'">
                                <span class="o_etd_chip">
                                    <i class="fa fa-exchange me-1"/>
                                    <t t-esc="filters.listing_type"/>
                                    <button class="o_etd_chip_remove" t-on-click="clearListingTypeFilter">×</button>
                                </span>
                            </t>
                            <t t-if="filters.state_filter !== 'all'">
                                <span class="o_etd_chip">
                                    <i class="fa fa-tasks me-1"/>
                                    <t t-esc="filters.state_filter"/>
                                    <button class="o_etd_chip_remove" t-on-click="clearStateFilter">×</button>
                                </span>
                            </t>
                            <t t-if="filters.period !== 'all'">
                                <span class="o_etd_chip">
                                    <i class="fa fa-calendar me-1"/>
                                    <t t-esc="selectedPeriodLabel"/>
                                    <button class="o_etd_chip_remove" t-on-click="clearPeriodFilter">×</button>
                                </span>
                            </t>
                        </div>
                    </t>
                </div>
            </t>

            <!-- Refreshing overlay indicator -->
            <t t-if="ui.refreshing">
                <div class="o_etd_refresh_bar">
                    <div class="o_etd_refresh_progress"/>
                </div>
            </t>

            <div class="px-4 pb-4 pt-3">

                <!-- ── KPI Cards ───────────────────────────────────────── -->
                <div class="row g-3 mb-4">

                    <!-- Active Listings -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="o_etd_kpi_card card border-0 shadow-sm h-100 cursor-pointer"
                             t-on-click="openMarketplace">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="o_etd_kpi_icon rounded-3 bg-primary bg-opacity-10 p-3 flex-shrink-0">
                                    <i class="fa fa-bullhorn fa-lg text-primary"/>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="text-muted small mb-1">Active Listings</div>
                                    <div class="fw-bold fs-3 lh-1">
                                        <t t-esc="data.kpi.active_listings"/>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <t t-esc="totalListings"/> total
                                    </div>
                                </div>
                                <i class="fa fa-chevron-right text-muted ms-auto"/>
                            </div>
                        </div>
                    </div>

                    <!-- Pending Signatures -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="o_etd_kpi_card card border-0 shadow-sm h-100 cursor-pointer"
                             t-on-click="openTradeOrders">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="o_etd_kpi_icon rounded-3 bg-warning bg-opacity-10 p-3 flex-shrink-0">
                                    <i class="fa fa-pencil-square-o fa-lg text-warning"/>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="text-muted small mb-1">Pending Signatures</div>
                                    <div class="fw-bold fs-3 lh-1"
                                         t-att-class="pendingSignaturesWarningClass">
                                        <t t-esc="data.kpi.pending_signatures"/>
                                    </div>
                                    <div class="text-muted small mt-1">awaiting sign</div>
                                </div>
                                <i class="fa fa-chevron-right text-muted ms-auto"/>
                            </div>
                        </div>
                    </div>

                    <!-- Portfolio Value -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="o_etd_kpi_card card border-0 shadow-sm h-100 cursor-pointer"
                             t-on-click="openPortfolio">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="o_etd_kpi_icon rounded-3 bg-success bg-opacity-10 p-3 flex-shrink-0">
                                    <i class="fa fa-bar-chart fa-lg text-success"/>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="text-muted small mb-1">Portfolio Value</div>
                                    <div class="fw-bold fs-4 lh-1 text-truncate" t-esc="portfolioValueFormatted"/>
                                    <div class="text-muted small mt-1">market value</div>
                                </div>
                                <i class="fa fa-chevron-right text-muted ms-auto"/>
                            </div>
                        </div>
                    </div>

                    <!-- Completed This Month -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="o_etd_kpi_card card border-0 shadow-sm h-100 cursor-pointer"
                             t-on-click="openTradeOrders">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="o_etd_kpi_icon rounded-3 bg-info bg-opacity-10 p-3 flex-shrink-0">
                                    <i class="fa fa-check-circle fa-lg text-info"/>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="text-muted small mb-1">Completed This Month</div>
                                    <div class="fw-bold fs-3 lh-1 text-info">
                                        <t t-esc="data.kpi.completed_trades_month"/>
                                    </div>
                                    <div class="text-muted small mt-1">transactions done</div>
                                </div>
                                <i class="fa fa-chevron-right text-muted ms-auto"/>
                            </div>
                        </div>
                    </div>

                </div><!-- /KPI row -->

                <!-- ── Charts Row ───────────────────────────────────────── -->
                <div class="row g-3 mb-4">

                    <!-- Listing Status Donut -->
                    <div class="col-12 col-lg-5">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-transparent border-0 pb-0">
                                <h6 class="fw-semibold mb-0">
                                    <i class="fa fa-pie-chart me-2 text-muted"/>Listing Status Breakdown
                                </h6>
                            </div>
                            <div class="card-body">
                                <t t-if="hasListingChartData">
                                    <div style="height:220px; position:relative;">
                                        <canvas t-ref="stateChart"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="d-flex flex-column align-items-center justify-content-center text-muted"
                                         style="height:200px;">
                                        <i class="fa fa-inbox fa-3x mb-2 opacity-25"/>
                                        <span>No listings yet</span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Weekly Activity Bar -->
                    <div class="col-12 col-lg-7">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-transparent border-0 pb-0">
                                <h6 class="fw-semibold mb-0">
                                    <i class="fa fa-bar-chart me-2 text-muted"/>Weekly New Listings (last 8 weeks)
                                </h6>
                            </div>
                            <div class="card-body">
                                <div style="height:220px; position:relative;">
                                    <canvas t-ref="activityChart"/>
                                </div>
                            </div>
                        </div>
                    </div>

                </div><!-- /charts row -->

                <!-- ── Tables Row ───────────────────────────────────────── -->
                <div class="row g-3">

                    <!-- Recent Listings -->
                    <div class="col-12 col-xl-7">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-transparent border-0 d-flex align-items-center justify-content-between">
                                <h6 class="fw-semibold mb-0">
                                    <i class="fa fa-history me-2 text-muted"/>Recent Listings
                                </h6>
                                <button class="btn btn-sm btn-link text-decoration-none p-0"
                                        t-on-click="openMarketplace">
                                    View all <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="data.recent_listings.length">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-sm mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="ps-3">ID</th>
                                                    <th>Type</th>
                                                    <th>Share Class</th>
                                                    <th class="text-end">Qty</th>
                                                    <th class="text-end pe-3">Total</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="data.recent_listings" t-as="rec" t-key="rec.id">
                                                    <tr class="cursor-pointer"
                                                        t-att-data-id="rec.id"
                                                        t-on-click="onListingRowClick">
                                                        <td class="ps-3 fw-semibold text-primary small">
                                                            <t t-esc="rec.name"/>
                                                        </td>
                                                        <td>
                                                            <span t-att-class="listingTypeBadge(rec.listing_type)"
                                                                  t-esc="listingTypeLabel(rec.listing_type)"/>
                                                        </td>
                                                        <td class="text-muted small" t-esc="rec.share_class"/>
                                                        <td class="text-end small" t-esc="rec.qty"/>
                                                        <td class="text-end pe-3 small fw-semibold">
                                                            <t t-esc="formatValue(rec.price_total, rec.currency_symbol)"/>
                                                        </td>
                                                        <td>
                                                            <span t-att-class="stateBadgeClass(rec.state)"
                                                                  t-esc="stateLabel(rec.state)"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5">
                                        <i class="fa fa-inbox fa-3x mb-2 opacity-25"/>
                                        <span>No listings match the current filters</span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Pending Actions + Quick Links -->
                    <div class="col-12 col-xl-5">
                        <div class="d-flex flex-column gap-3 h-100">

                            <!-- Pending Actions -->
                            <div class="card border-0 shadow-sm flex-grow-1">
                                <div class="card-header bg-transparent border-0 pb-0">
                                    <h6 class="fw-semibold mb-0">
                                        <i class="fa fa-exclamation-circle me-2 text-warning"/>Pending Actions
                                    </h6>
                                </div>
                                <div class="card-body p-0">
                                    <t t-if="data.pending_actions.length">
                                        <ul class="list-group list-group-flush">
                                            <t t-foreach="data.pending_actions" t-as="item" t-key="item.id">
                                                <li class="list-group-item list-group-item-action d-flex align-items-center gap-2 cursor-pointer"
                                                    t-att-data-id="item.id"
                                                    t-on-click="onListingRowClick">
                                                    <div class="flex-grow-1 overflow-hidden">
                                                        <div class="fw-semibold small text-truncate" t-esc="item.name"/>
                                                        <div class="text-muted small" t-esc="item.shareholder"/>
                                                    </div>
                                                    <div class="flex-shrink-0 text-end">
                                                        <span t-att-class="stateBadgeClass(item.state)"
                                                              t-esc="stateLabel(item.state)"/>
                                                        <div class="text-primary small mt-1" t-esc="item.action_label"/>
                                                    </div>
                                                    <i class="fa fa-chevron-right text-muted small"/>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>
                                    <t t-else="">
                                        <div class="d-flex align-items-center justify-content-center text-muted py-4">
                                            <i class="fa fa-check-circle text-success me-2"/>
                                            All listings are up to date
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Quick Navigation -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-transparent border-0 pb-0">
                                    <h6 class="fw-semibold mb-0">
                                        <i class="fa fa-th-large me-2 text-muted"/>Quick Navigation
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-grid gap-2">
                                        <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2"
                                                t-on-click="openMarketplace">
                                            <i class="fa fa-bullhorn"/>
                                            <span>Marketplace Board</span>
                                        </button>
                                        <button class="btn btn-outline-success btn-sm d-flex align-items-center gap-2"
                                                t-on-click="openPortfolio">
                                            <i class="fa fa-briefcase"/>
                                            <span>Portfolio Assets</span>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2"
                                                t-on-click="openTradeOrders">
                                            <i class="fa fa-exchange"/>
                                            <span>Trade Orders</span>
                                        </button>
                                        <button class="btn btn-outline-info btn-sm d-flex align-items-center gap-2"
                                                t-on-click="openRevaluations">
                                            <i class="fa fa-refresh"/>
                                            <span>Portfolio Revaluations</span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </div><!-- /flex column -->
                    </div>

                </div><!-- /tables row -->
            </div><!-- /px-4 -->
        </t><!-- /else loaded -->
    </div><!-- /dashboard root -->
</t>

</templates>
